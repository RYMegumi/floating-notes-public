# Copy this file to .env.local and fill in the two values from
# Supabase Dashboard → Project Settings → API / API Keys.
#
# Project URL, for example:
# https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Publishable key (the current name for the public anon key).
# Never put a secret key / service_role key in this file.
SUPABASE_PUBLISHABLE_KEY=
