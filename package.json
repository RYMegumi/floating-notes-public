{
  "name": "fujian",
  "version": "1.4.0",
  "description": "浮笺 — 一款融入桌面的无边框任务便签",
  "main": "./out/main/index.js",
  "author": "Fujian",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build": "npm run typecheck && electron-vite build",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win portable",
    "build:mac": "npm run build && electron-builder --mac",
    "build:mac:dir": "npm run build && electron-builder --mac --dir",
    "build:mac:arm64": "npm run build && electron-builder --mac --dir --arm64",
    "release": "node scripts/release-c.mjs",
    "test:ui": "node tests/ui.mjs",
    "test:layout": "node tests/layout.mjs",
    "test:packaged": "node tests/packaged.mjs",
    "test:portable-c": "node tests/portable-c.mjs",
    "test:mac": "node tests/macos.mjs",
    "test:notes": "node tests/notes.mjs",
    "test:i18n": "node tests/i18n.mjs",
    "preview": "node tests/preview.mjs",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0"
  },
  "devDependencies": {
    "@types/node": "^24.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.70.0",
    "playwright-core": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  },
  "build": {
    "appId": "com.fujian.widget",
    "productName": "浮笺",
    "copyright": "Copyright © 2026 Fujian",
    "asar": true,
    "asarUnpack": [
      "node_modules/electron-liquid-glass/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "extraResources": [
      {
        "from": "resources/tray.png",
        "to": "tray.png"
      },
      {
        "from": "resources/trayTemplate.png",
        "to": "trayTemplate.png"
      },
      {
        "from": "resources/trayTemplate@2x.png",
        "to": "trayTemplate@2x.png"
      },
      {
        "from": "resources/app-icon.png",
        "to": "app-icon.png"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "浮笺-${version}-便携版.${ext}"
    },
    "portable": {
      "requestExecutionLevel": "user"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "LSUIElement": true
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "浮笺-${version}-mac-${arch}.${ext}"
    },
    "toolsets": {
      "nsis": "1.2.1"
    },
    "publish": null
  },
  "optionalDependencies": {
    "electron-liquid-glass": "^1.1.1"
  }
}
